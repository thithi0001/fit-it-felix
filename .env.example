NODE_ENV=development

GATEWAY_PORT=3000
AUTH_PORT=3001
USER_PORT=3002
DEVICE_PORT=3003
INVENTORY_PORT=3004
MAINTENANCE_PORT=3005

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

AUTH_SERVICE_URL=http://auth:3001
