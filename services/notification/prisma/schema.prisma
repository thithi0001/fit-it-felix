generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model noti_users {
  id              BigInt        @id @default(autoincrement())
  notification_id BigInt
  employee_id     BigInt
  is_read         Boolean       @default(false)
  read_at         DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  notifications   notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_noti_users_notification")

  @@unique([notification_id, employee_id], map: "uq_noti_users_notification_employee")
  @@index([employee_id], map: "idx_noti_users_employee")
  @@index([employee_id, is_read], map: "idx_noti_users_employee_read")
  @@index([notification_id], map: "idx_noti_users_notification")
}

model notifications {
  id                     BigInt            @id @default(autoincrement())
  created_by_employee_id BigInt
  notification_type      notification_type
  title                  String            @db.VarChar(255)
  content                String
  reference_type         String?           @db.VarChar(100)
  reference_id           BigInt?
  created_at             DateTime          @default(now()) @db.Timestamptz(6)
  updated_at             DateTime          @default(now()) @db.Timestamptz(6)
  noti_users             noti_users[]

  @@index([created_by_employee_id], map: "idx_notifications_created_by_employee")
  @@index([reference_type, reference_id], map: "idx_notifications_reference")
  @@index([notification_type], map: "idx_notifications_type")
}

enum notification_type {
  acceptance_report
  damage_report
  device_request
  inventory_request
  maintenance_request
  repair_request
  plan_schedule
  approval
  system
  test
}
