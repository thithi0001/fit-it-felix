generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory {
  id                   BigInt                 @id @default(autoincrement())
  item_id              BigInt
  supplier_id          BigInt
  quantity             Int                    @default(0)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  items                items                  @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_item")
  suppliers            suppliers              @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_supplier")
  item_request_details item_request_details[]
  receipt_details      receipt_details[]

  @@unique([item_id, supplier_id], map: "uq_inventory_item_supplier")
  @@index([item_id], map: "idx_inventory_item")
  @@index([supplier_id], map: "idx_inventory_supplier")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model item_request_details {
  id              BigInt        @id @default(autoincrement())
  item_request_id BigInt
  inventory_id    BigInt
  quantity        Int           @default(1)
  inventory       inventory     @relation(fields: [inventory_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_request_details_inventory")
  item_requests   item_requests @relation(fields: [item_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_item_request_details_request")

  @@unique([item_request_id, inventory_id], map: "uq_item_request_details_request_inventory")
  @@index([inventory_id], map: "idx_item_request_details_inventory")
}

model item_requests {
  id                      BigInt                 @id @default(autoincrement())
  created_by_employee_id  BigInt
  plan_id                 BigInt?
  request_type            request_type
  status                  request_status         @default(pending)
  reason                  String?
  approved_by_employee_id BigInt?
  created_at              DateTime               @default(now()) @db.Timestamptz(6)
  updated_at              DateTime               @default(now()) @db.Timestamptz(6)
  item_request_details    item_request_details[]

  @@index([approved_by_employee_id], map: "idx_item_requests_approved_by_employee")
  @@index([created_by_employee_id], map: "idx_item_requests_created_by_employee")
  @@index([request_type, status], map: "idx_item_requests_type_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model items {
  id              BigInt        @id @default(autoincrement())
  manufacturer_id BigInt
  code            String        @unique @db.VarChar(50)
  name            String        @db.VarChar(100)
  unit            String        @db.VarChar(20)
  minimum_stock   Int           @default(1)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  inventory       inventory[]
  manufacturers   manufacturers @relation(fields: [manufacturer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_items_manufacturer")

  @@index([manufacturer_id], map: "idx_items_manufacturer")
}

model manufacturers {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique @db.VarChar(50)
  name       String   @db.VarChar(100)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  items      items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model receipt_details {
  id           BigInt    @id @default(autoincrement())
  receipt_id   BigInt
  inventory_id BigInt
  quantity     Int       @default(1)
  unit_price   Decimal?  @db.Decimal(12, 2)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  inventory    inventory @relation(fields: [inventory_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_receipt_details_inventory")
  receipts     receipts  @relation(fields: [receipt_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_receipt_details_receipt")

  @@unique([receipt_id, inventory_id], map: "uq_receipt_details_receipt_inventory")
  @@index([inventory_id], map: "idx_receipt_details_inventory")
}

model receipts {
  id                     BigInt            @id @default(autoincrement())
  supplier_id            BigInt
  created_by_employee_id BigInt
  receipt_number         String            @unique @db.VarChar(20)
  created_at             DateTime          @default(now()) @db.Timestamptz(6)
  updated_at             DateTime          @default(now()) @db.Timestamptz(6)
  receipt_details        receipt_details[]
  suppliers              suppliers         @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_receipts_supplier")

  @@index([created_by_employee_id], map: "idx_receipts_created_by_employee")
  @@index([supplier_id], map: "idx_receipts_supplier")
}

model suppliers {
  id         BigInt      @id @default(autoincrement())
  code       String      @unique @db.VarChar(50)
  name       String      @db.VarChar(100)
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)
  inventory  inventory[]
  receipts   receipts[]
}

enum request_status {
  pending
  success
  fail
}

enum request_type {
  issue
  return
}
