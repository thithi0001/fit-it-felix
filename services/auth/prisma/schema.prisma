generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model approvals {
  id                     BigInt          @id @default(autoincrement())
  table_name             String          @db.VarChar(100)
  record_id              BigInt
  approved_by_account_id BigInt
  action                 approval_action
  note                   String?
  acted_at               DateTime        @default(now()) @db.Timestamptz(6)
  accounts               accounts        @relation(fields: [approved_by_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_approvals_account")

  @@index([table_name, record_id], map: "idx_approvals_record")
  @@index([approved_by_account_id], map: "idx_approvals_account")
}

model departments {
  id          BigInt      @id @default(autoincrement())
  name        String      @unique @db.VarChar(150)
  description String?
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  employees   employees[]
}

model employees {
  id               BigInt       @id @default(autoincrement())
  department_id    BigInt?
  employee_code    String       @unique @db.VarChar(30)
  full_name        String       @db.VarChar(150)
  position         String?      @db.VarChar(100)
  phone            String?      @db.VarChar(20)
  date_of_birth    DateTime?    @db.Date
  hire_date        DateTime?    @db.Date
  termination_date DateTime?    @db.Date
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @default(now()) @db.Timestamptz(6)
  accounts         accounts?
  departments      departments? @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "fk_employee_department")

  @@index([department_id], map: "idx_employees_department")
}

model roles {
  id          BigInt     @id @default(autoincrement())
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(100)
  description String?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  accounts    accounts[]
}

model accounts {
  id            BigInt         @id @default(autoincrement())
  employee_id   BigInt         @unique
  role_id       BigInt
  username      String         @unique @db.Citext
  email         String         @unique @db.Citext
  password_hash String
  status        account_status @default(active)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  employees     employees      @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_accounts_employee")
  roles         roles          @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_accounts_role")
  approvals     approvals[]

  @@index([employee_id], map: "idx_accounts_employee")
  @@index([role_id], map: "idx_accounts_role")
}

enum approval_action {
  approved
  rejected
  cancelled
}

enum account_status {
  active
  locked
}
