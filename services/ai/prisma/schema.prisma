generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_requests {
  id                BigInt            @id @default(autoincrement())
  conversation_id   BigInt
  message_id        BigInt?
  model_name        String            @db.VarChar(100)
  prompt_tokens     Int?
  completion_tokens Int?
  total_tokens      Int?
  response_time_ms  Int?
  status            ai_request_status
  error_message     String?
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  conversations     conversations     @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_requests_conversation")
  messages          messages?         @relation(fields: [message_id], references: [id], onUpdate: NoAction, map: "fk_ai_requests_message")

  @@index([conversation_id, created_at], map: "idx_ai_requests_conversation")
  @@index([created_at], map: "idx_ai_requests_created_at")
  @@index([message_id], map: "idx_ai_requests_message")
  @@index([model_name], map: "idx_ai_requests_model_name")
  @@index([status], map: "idx_ai_requests_status")
}

model conversations {
  id          BigInt              @id @default(autoincrement())
  employee_id BigInt
  title       String?             @db.VarChar(255)
  status      conversation_status @default(active)
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at  DateTime            @default(now()) @db.Timestamptz(6)
  ai_requests ai_requests[]
  messages    messages[]

  @@index([employee_id], map: "idx_conversations_employee")
  @@index([employee_id, status], map: "idx_conversations_employee_status")
}

model messages {
  id              BigInt        @id @default(autoincrement())
  conversation_id BigInt
  role            message_role
  content         String
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  ai_requests     ai_requests[]
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_messages_conversation")

  @@index([conversation_id, created_at], map: "idx_messages_conversation")
}

enum ai_request_status {
  success
  failed
}

enum conversation_status {
  active
  archived
}

enum message_role {
  system
  user
  assistant
}
